{
  "name": "nizam-al-idara-desktop",
  "productName": "Nizam Al-Idara",
  "version": "1.0.0",
  "private": true,
  "description": "نسخة سطح المكتب — Windows 32/64 (Setup + Portable) مع حفظ SQLite",
  "main": "main.js",
  "scripts": {
    "serve": "node server.js",
    "start": "electron .",
    "prepare:google": "node prepare-google-client.js",
    "dist:win64": "node prepare-google-client.js && electron-builder --win nsis --x64",
    "dist:win32": "node prepare-google-client.js && electron-builder --win nsis --ia32",
    "dist:win-portable64": "node prepare-google-client.js && electron-builder --win portable --x64",
    "dist:win-portable32": "node prepare-google-client.js && electron-builder --win portable --ia32",
    "dist:win-all": "node prepare-google-client.js && electron-builder --win nsis portable --x64 --ia32",
    "dist:linux": "node prepare-google-client.js && electron-builder --linux AppImage deb --x64",
    "dist:mac": "node prepare-google-client.js && electron-builder --mac dmg --x64 --arm64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.amw.nizam-idara",
    "productName": "Nizam Al-Idara",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "google.js",
      "google-client.json",
      {
        "from": "../dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../icons",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "../icons/icon-source-1024.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nizam Al-Idara",
      "artifactName": "nizam-setup-${arch}.${ext}",
      "license": null
    },
    "portable": {
      "artifactName": "nizam-portable-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    }
  }
}
