<!-- ============================================================
     قواعد النسخ الاحتياطي التلقائي (Android 11 وأقدم)
     ------------------------------------------------------------
     بيانات التطبيق بتتخزن في localStorage بتاع WebView، ومكانها
     جوه مجلد files (app_webview/Local Storage). من غير القواعد دي
     أندرويد كان ممكن يستثنيها من النسخة الاحتياطية، فلما المستخدم
     يعيد تثبيت التطبيق أو يغيّر التليفون يلاقي البيانات فاضية.
     ============================================================ -->
<full-backup-content>
    <include domain="file" path="." />
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
</full-backup-content>
